/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    withName: 'CUSTOM_DUMPSOFTWAREVERSIONS' {
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: params.publish_dir_mode,
            pattern: 'versions.yml'
        ]
    }
}

process {

    withName: 'ORTHOFINDER' {
        ext.args   = ''
        publishDir = [
            path: { "${params.outdir}/tools/orthofinder" },
            mode: params.publish_dir_mode,
            // NOTE: no trailing slash -- Nextflow's publishDir path normalization
            // drops a trailing '/' on a directory pattern (a known Nextflow
            // limitation, esp. with S3/cloud storage), so it silently never
            // matches and nothing gets published (no error, just an empty dir).
            pattern: "ortho_f/OrthoFinder/Results_*/Orthologues/Orthologues_${params.project_id}.final.transdecoder.pep" ,
            enabled: params.save_tool_outs
        ]
        errorStrategy = 'ignore'
    }
    withName: 'EGGNOGMAPPER' {
        ext.args   = ''
        publishDir = [
            path: { "${params.outdir}/tools/eggnog" },
            mode: params.publish_dir_mode,
            enabled: params.save_tool_outs
        ]
    }
    withName: 'TREEGRAFTER' {
        ext.args   = ''
        publishDir = [
            path: { "${params.outdir}/tools/treegrafter" },
            mode: params.publish_dir_mode,
            enabled: params.save_tool_outs
        ]
    }
    withName: 'ORTHOLOGER' {
        ext.args   = ''
        publishDir = [
            path: { "${params.outdir}/tools/orthologer" },
            pattern: 'odbwork/Cluster/odbproj.og' ,
            mode: params.publish_dir_mode,
            enabled: params.save_tool_outs
        ]
    }
    withName: 'POST_PROC' {
        ext.args   = ''
    }
    withName: 'TRANSDECODER_PREDICT' {
        ext.args   = '--single_best_only'
        publishDir = [
            path: { "${params.outdir}/transdecoder/t_predict" },
            mode: params.publish_dir_mode,
            enabled: params.save_proteins
        ]
    }
    withName: 'TRANSDECODER_LONGORF' {
        ext.args   = '--complete_orfs_only'
        publishDir = [
            path: { "${params.outdir}/transdecoder/t_longorf" },
            mode: params.publish_dir_mode,
            enabled: params.save_proteins
        ]
    }
    withName: 'HMMER_HMMSCAN' {
        ext.args   = ''
        publishDir = [
            path: { "${params.outdir}/transdecoder/hmmscan" },
            mode: params.publish_dir_mode,
            enabled: params.save_proteins
        ]
    }
    withName: 'TBL_2_JSON_1V1' {
        ext.args = { meta.id }
    }
    withName: 'GFFREAD' {
        publishDir = [
            path: { "${params.outdir}/gffread/" },
            mode: params.publish_dir_mode,
            enabled: params.save_transcripts
        ]
    }
    withName: 'VOTE_BEST_MATCH' {
        ext.args   = "--min-tool-support ${params.min_tool_support}"
        publishDir = [
            path: { "${params.outdir}/consensus_vote" },
            mode: params.publish_dir_mode,
        ]
    }
    withName: 'GTF_TO_GENELISTS' {
        publishDir = [
            path: { "${params.outdir}/synteny/genelists" },
            mode: params.publish_dir_mode,
            enabled: params.save_tool_outs
        ]
    }
    // ext.when below replaces the Groovy-level `if (params.run_synteny)`/
    // `if (params.run_structural)` wrappers these processes used to be
    // called from in orthologymap.nf: wrapping a *second* consumer of a
    // channel shared with another process (ch_query_pep/ch_ref_pep, shared
    // with the foldseek processes below) in a separate top-level `if` block
    // deadlocked under -resume in testing (the second consumer's queue
    // port reported "closed" having delivered zero items). Calling every
    // process unconditionally and gating actual execution via ext.when
    // instead avoids that: there's no longer any conditional block boundary
    // between the two consumers at all.
    withName: 'GTF_TO_GENELISTS_QUERY' {
        ext.when = { params.run_synteny }
        publishDir = [
            path: { "${params.outdir}/synteny/genelists" },
            mode: params.publish_dir_mode,
            enabled: params.save_tool_outs
        ]
    }
    withName: 'GTF_TO_GENELISTS_REF' {
        ext.when = { params.run_synteny }
        publishDir = [
            path: { "${params.outdir}/synteny/genelists" },
            mode: params.publish_dir_mode,
            enabled: params.save_tool_outs
        ]
    }
    withName: 'DIAMOND_BLASTP' {
        ext.args = ''
        ext.when = { params.run_synteny }
        publishDir = [
            path: { "${params.outdir}/synteny/blast" },
            mode: params.publish_dir_mode,
            enabled: params.save_tool_outs
        ]
    }
    withName: 'IADHORE' {
        ext.args = ''
        ext.when = { params.run_synteny }
        publishDir = [
            path: { "${params.outdir}/tools/iadhore" },
            mode: params.publish_dir_mode,
            pattern: 'output/*.txt',
            enabled: params.save_tool_outs
        ]
    }

    withName: 'MULTIPLICON_TO_GENES' {
        ext.when = { params.run_synteny }
        publishDir = [
            path: { "${params.outdir}/tools/iadhore" },
            mode: params.publish_dir_mode,
            pattern: 'multiplicon_genes.txt',
            enabled: params.save_tool_outs
        ]
    }
    withName: 'SYNTENY_POST' {
        ext.when = { params.run_synteny }
    }

    withName: 'FOLDSEEK_DOWNLOAD_PROSTT5' {
        ext.when = { params.run_structural }
        publishDir = [
            path: { "${params.prostt5_weights_dir}" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'FOLDSEEK_SEARCH' {
        ext.when = { params.run_structural }
        publishDir = [
            path: { "${params.outdir}/tools/foldseek" },
            mode: params.publish_dir_mode,
            pattern: '*.structural_hits.tsv',
            enabled: params.save_tool_outs
        ]
    }

    // withName matches the process ALIAS (FOLDSEEK_CREATEDB_QUERY/_REF),
    // not the underlying process name FOLDSEEK_CREATEDB, so both aliases
    // need their own block (same reason as the GPU config in mmc.config).
    // Publishes newly-predicted 3Di sequences back into the persistent
    // cache; always enabled regardless of save_tool_outs since this is the
    // whole point of the caching mechanism, not an optional diagnostic.
    withName: 'FOLDSEEK_CREATEDB_QUERY' {
        ext.when = { params.run_structural }
        publishDir = [
            path: { "${params.prostt5_3di_cache_dir}" },
            mode: params.publish_dir_mode,
            pattern: '*.3di'
        ]
    }
    withName: 'FOLDSEEK_CREATEDB_REF' {
        ext.when = { params.run_structural }
        publishDir = [
            path: { "${params.prostt5_3di_cache_dir}" },
            mode: params.publish_dir_mode,
            pattern: '*.3di'
        ]
    }
}
